# ---------------------------------------------------------------------------
# Clinic Management Lite - environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase / Railway / local Postgres).
# Pooled connection - used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct (non-pooled) connection - used by `prisma migrate`.
# For Neon this is the same host without the `-pooler` suffix.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Password assigned to every seeded demo account.
SEED_PASSWORD="Passw0rd!"
